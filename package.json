{
  "name": "norway-data-api",
  "version": "1.1.4",
  "private": true,
  "description": "A small public REST API with facts about Norway, served by a Netlify Function and described by an OpenAPI 3.1 spec.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node scripts/contract-test.mjs",
    "lint": "redocly lint public/openapi/norway-data.yaml",
    "check:bundle": "zip-it-and-ship-it netlify/functions .netlify/bundle-check",
    "check:version": "node scripts/check-version.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "dev": "npx --yes netlify-cli@27.12.0 dev"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "16.3.0",
    "@redocly/cli": "2.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.3.2"
  }
}
